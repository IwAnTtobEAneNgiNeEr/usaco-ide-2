{
  "name": "usaco-ide-2-backend",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Local backend for USACO IDE 2.0 — file-based C++ problem workspace + g++ judge.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --require ./test/_isolate-workspace.js --test --test-concurrency=2 \"test/**/*.test.js\"",
    "analyze-events": "node ../scripts/analyze-events.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
