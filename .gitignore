# Dependencies and generated build output (GitHub Node template, scoped here)
node_modules/
/desktop/dist/
/desktop/out/
__pycache__/
*.pyc
*.log

# Runtime: exclude contents, preserve reviewable examples; do not ignore .in/.out fixtures
/data/*
!/data/*.example.json
/workspace/
/user-data/
/test-data/
/runtime/
/.runtime/
/.local/
/temp/
/tmp/
/cache/
/runs/
/usaco-audit-kit/
/browser-profile*/
/browser-output/
/screenshots/
/evidence/
/reports/

# Credentials/environment (examples allowed explicitly)
.env
.env.*
!.env.example
.npmrc
!.npmrc.example
*.pem
*.key
*.p12
*.pfx
*.kdbx

# Root delivery archives and accidental root executable output; fixtures stay visible
/*.zip
/*.exe
/*.dll
/*.o
/*.obj
/*.gch

# Editor/OS state
.DS_Store
Thumbs.db
.claude/
.impeccable/
.planning/
